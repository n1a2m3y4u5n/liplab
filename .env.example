# LIPLAB Environment Variables
# Copy this file to .env and fill in your values

# JWT Secret (use a strong random string in production)
JWT_SECRET=liplab-super-secret-key-change-in-production-2024

# Anthropic API Key for Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Database URL
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./liplab.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# Application Settings
PORT=8080
ENVIRONMENT=development

# ── 축 A D-GOP 음향 채점 (선택) ──────────────────────────────────────────────
# 미설정이 기본값이며, 그때는 기존 전사(faster-whisper) 경로로 채점한다.
#
# 🚨 2026-09-15 현재 **켜지 말 것.** 채점식을 naive로 교체해 원점수 눈금이 바뀌었는데
#    표시 점수 보정 앵커(backend/data/dgop_calibration.json)는 아직 구 식으로 잰 값이다.
#    A-3 재측정 → A-4 재적합이 끝나야 유효하다(STATUS.md 1순위 2·3단계).
#
# DGOP_ALIGNER_ID=duadnwls/liplab-dgop-aligner    # 강제정렬용(A-2 산출물)
# DGOP_SCORER_ID=duadnwls/liplab-dgop-scorer      # 채점용(A-1 산출물). 생략 시 정렬기와 동일
# DGOP_CALIBRATION=                               # 앵커 JSON 경로. 생략 시 backend/data/dgop_calibration.json
#
# ⚠️ 위 두 저장소는 **비공개**다. 앱이 가중치를 받으려면 읽기 권한 토큰이 함께 있어야 한다.
#    없으면 모델 로드가 실패하고 전사 경로로 폴백한다(로그에 [WARN] D-GOP 경로 실패가 찍힌다).
# HF_TOKEN=your-huggingface-read-token

# ── 콘텐츠 사람검수(축 G, 운영자 전용) ─────────────────────────────────────
# /admin/content-review 화면과 /api/admin/content/* 를 켠다. 켜도 아래 목록에 있는 계정만 쓸 수 있고,
# 목록이 비어 있으면 아무도 못 쓴다(공용 데모 계정은 항상 불가).
# LIPLAB_REVIEW=1
# LIPLAB_ADMIN_EMAILS=reviewer1@example.com,reviewer2@example.com
